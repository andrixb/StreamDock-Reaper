# ReaperControl OSC pattern config for the StreamDock plugin.
# Install location (the Auto-Setup script copies it there for you):
#   Windows: %APPDATA%\REAPER\OSC\ReaperControl.ReaperOSC
#   macOS:   ~/Library/Application Support/REAPER/OSC/ReaperControl.ReaperOSC
#
# REAPER control surface settings (Preferences > Control/OSC/web > Add > OSC):
#   Pattern config:   ReaperControl
#   Mode:             Configure device IP + local port
#   Device port:      9000        (the plugin listens here)
#   Device IP:        127.0.0.1
#   Local listen port: 8000       (REAPER listens here)
#
# Track numbers are absolute (1..DEVICE_TRACK_COUNT); the plugin does its own
# banking, so keep the device track bank at 0.

DEVICE_TRACK_COUNT 64
DEVICE_SEND_COUNT 0
DEVICE_RECEIVE_COUNT 0
DEVICE_FX_COUNT 8
DEVICE_FX_PARAM_COUNT 16
DEVICE_FX_INST_PARAM_COUNT 0
DEVICE_MARKER_COUNT 0
DEVICE_REGION_COUNT 0

REAPER_TRACK_FOLLOWS REAPER
DEVICE_TRACK_FOLLOWS DEVICE
DEVICE_TRACK_BANK_FOLLOWS DEVICE
DEVICE_FX_FOLLOWS DEVICE
DEVICE_EQ EXISTING
DEVICE_ROTARY_CENTER 0

# Actions (the plugin triggers 41743 "Control surface: Refresh all surfaces")
ACTION i/action t/action/@

# Transport
PLAY t/play
STOP t/stop
PAUSE t/pause
RECORD t/record
REPEAT t/repeat
METRONOME t/click

# Tracks
TRACK_NAME s/track/@/name
TRACK_MUTE b/track/@/mute t/track/@/mute/toggle
TRACK_SOLO b/track/@/solo t/track/@/solo/toggle
TRACK_REC_ARM b/track/@/recarm t/track/@/recarm/toggle
TRACK_SELECT b/track/@/select
TRACK_VU n/track/@/vu
TRACK_VU_L n/track/@/vu/L
TRACK_VU_R n/track/@/vu/R
TRACK_VOLUME n/track/@/volume
TRACK_VOLUME f/track/@/volume/db
TRACK_PAN n/track/@/pan

# Master
MASTER_VOLUME n/master/volume
MASTER_PAN n/master/pan
MASTER_VU n/master/vu
MASTER_VU_L n/master/vu/L
MASTER_VU_R n/master/vu/R

# FX (track-addressed)
FX_NAME s/track/@/fx/@/name
FX_BYPASS b/track/@/fx/@/bypass
FX_OPEN_UI b/track/@/fx/@/openui
FX_PARAM_NAME s/track/@/fx/@/fxparam/@/name
FX_PARAM_VALUE n/track/@/fx/@/fxparam/@/value s/track/@/fx/@/fxparam/@/value/str

# Last touched FX parameter
LAST_TOUCHED_FX_PARAM_NAME s/fxparam/last_touched/name
LAST_TOUCHED_FX_PARAM_VALUE n/fxparam/last_touched/value s/fxparam/last_touched/value/str
